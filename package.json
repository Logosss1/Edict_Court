{
  "name": "edict-for-mac",
  "productName": "Edict",
  "version": "1.0.0",
  "description": "Edict for Mac · 三省六部像素朝堂桌面 AI 编程工作站",
  "main": "dist/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "assets": "node scripts/gen-pixel-assets.mjs",
    "start": "npm run build && electron .",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "node e2e/run-e2e.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "dmg": "bash scripts/make-dmg.sh"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "esbuild": "0.27.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3",
    "tsx": "^4",
    "playwright": "1.56.0"
  },
  "edict": {
    "vendored": {
      "monaco-editor": "0.40.0 (min build, MIT)",
      "phaser": "3.90.0 (MIT)",
      "xterm.js": "5.5.0 (MIT, bundled from source)",
      "fusion-pixel-font": "2026.09.01 (OFL-1.1)"
    }
  }
}
